# BH Group production environment template.
# Copy to .env.production, chmod 600, and replace every REQUIRED placeholder.
# Never commit .env.production or paste its contents into tickets/chat/logs.

# REQUIRED secrets and bootstrap identity
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_64_RANDOM_BYTES
SUPER_ADMIN_EMAIL=admin@example.invalid
SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_BOOTSTRAP_PASSWORD

# Safe PostgreSQL defaults
POSTGRES_DB=bhgroup_pms
POSTGRES_USER=bhgroup

# Public production URLs and cookie/CORS policy
APP_BASE_URL=https://bhstays.ro
APP_API_BASE_URL=https://bhstays.ro/api/v1
NEXT_PUBLIC_API_BASE_URL=https://bhstays.ro/api/v1
NEXT_PUBLIC_SITE_URL=https://bhstays.ro
UPLOAD_PUBLIC_BASE_URL=https://bhstays.ro/uploads
CORS_ALLOWED_ORIGINS=https://bhstays.ro,https://www.bhstays.ro
REFRESH_COOKIE_SECURE=true
APP_NAME=BH Group PMS

# Optional token lifetime overrides (milliseconds)
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Optional public company contact details
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=

# Optional SMTP. Leave credentials empty when email delivery is not configured.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@bhstays.ro

# Optional Anthropic assistant. An empty key keeps the contact fallback active.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=400
ANTHROPIC_MAX_HISTORY_MESSAGES=16
ANTHROPIC_TIMEOUT_MS=15000
ASSISTANT_CHAT_RETENTION_DAYS=90

# Optional Google Maps browser key. Restrict a real key to bhstays.ro in Google.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional Stripe. Empty values intentionally disable card payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional local image tag used for backend/frontend builds (never use latest).
APP_IMAGE_TAG=production
