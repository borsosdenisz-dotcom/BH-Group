# ============================================================
# BH Group PMS — Environment Variables
# Copy this file to .env and fill in real values before running
# docker compose up
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=bhgroup_pms
POSTGRES_USER=bhgroup
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://postgres:5432/bhgroup_pms
DB_USERNAME=bhgroup
DB_PASSWORD=change-me-strong-password

# JWT
JWT_SECRET=replace-with-a-base64-secret-of-at-least-64-bytes-in-production
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Mail (SMTP) - real transactional delivery, not a sandbox/testing tool.
# Get SMTP credentials from your provider's dashboard, e.g.:
#   Brevo:  https://app.brevo.com/settings/keys/smtp  (host: smtp-relay.brevo.com, port 587)
#   Resend: https://resend.com/domains -> verify a domain -> SMTP tab (host: smtp.resend.com, port 587)
# All 5 values below come strictly from these env vars (see application.yml) -
# nothing here or in code defaults to a real host/credential. If left as
# placeholders, the app logs a clear startup warning and every email attempt
# is caught and logged as a failure instead of breaking the app (see
# EmailDispatcher/MailConfigDiagnostics) - never commit real values here.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM=no-reply@bhgroup.io

# App
APP_BASE_URL=http://localhost:3000
APP_NAME=BH Group PMS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to true once the app is served over HTTPS (required for the browser to
# send the httpOnly refresh-token cookie back). Keep false for local http dev.
REFRESH_COOKIE_SECURE=false

# Bootstraps the first SUPER_ADMIN account on first startup (only if no SUPER_ADMIN exists yet)
SUPER_ADMIN_EMAIL=admin@bhgroup.io
SUPER_ADMIN_PASSWORD=change-me-strong-password

# File storage (property photos/documents)
UPLOAD_DIR=/data/uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:8080/uploads

# Claude / Anthropic (AI FAQ assistant) - required for the chat widget to give
# real answers; if unset the widget falls back to the contact message instead
# of erroring out.
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=400
ANTHROPIC_MAX_HISTORY_MESSAGES=16
ANTHROPIC_TIMEOUT_MS=15000
# How long assistant handoff chats (name/email/messages a visitor may have
# given) are kept before the retention job deletes them - GDPR storage
# limitation, not a feature setting. See AssistantChatRetentionScheduler.
ASSISTANT_CHAT_RETENTION_DAYS=90

# --- Stripe (card payments via hosted Checkout) ---
# Leave empty to disable card payments entirely - the booking flow then
# offers manual payment only (bank transfer / on arrival). Use TEST keys
# (sk_test_.../pk_test_...) for anything that isn't production.
# The webhook secret comes from the Stripe dashboard (or `stripe listen`)
# and is what makes the webhook trustworthy - without it, nothing is
# processed. Never commit real values.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=
